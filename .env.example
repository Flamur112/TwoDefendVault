# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sessions
SESSION_SECRET=

# App (production: https://vault.twodefend.com)
APP_URL=http://localhost:3000
ORG_SLUG=twodefend

# Secret for scheduled retention purge (Netlify cron). Generate a long random string.
CRON_SECRET=

# Vault key material (org-level, not per-user)
VAULT_KEY_MATERIAL=

# Zoho OAuth 2.0 (server-side only)
# OAuth callback is derived from APP_URL → {APP_URL}/api/auth/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_AUTH_URL=https://accounts.zoho.eu/oauth/v2/auth
ZOHO_TOKEN_URL=https://accounts.zoho.eu/oauth/v2/token
ZOHO_USER_INFO_URL=https://accounts.zoho.eu/oauth/v2/userinfo

# Database direct connection (local migrations only — npm run migrate)
# Supabase → Project Settings → Database → Database password
SUPABASE_DB_PASSWORD=

# If direct connection fails (IPv6 ENETUNREACH), copy the Session pooler host from Supabase:
# SUPABASE_DB_POOLER_HOST=aws-1-eu-west-1.pooler.supabase.com

# Or paste the full URI instead:
# DATABASE_URL=postgresql://postgres:...@db.xxxx.supabase.co:5432/postgres

NODE_ENV=development
